# Copy to ~/aedoxy-web/.env on the VPS and fill in. Never commit real values.
# Generate secrets with: openssl rand -hex 24
# Use hex/alphanumeric passwords only: they are embedded in connection URLs.

# Postgres superuser used by the gateway (database "gateway-aedoxy")
POSTGRES_USER=gateway
POSTGRES_PASSWORD=
# Password of the non-superuser role "aedoxy" that owns the web database "aedoxy"
AEDOXY_DB_PASSWORD=
REDIS_PASSWORD=

# Gateway session signing key (required for multi-node and stable logins)
SESSION_SECRET=

# aedoxy-web (validated by src/env.ts, ENV_STRICT=true)
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONSOLE_OIDC_CLIENT_ID=aedoxy-console
# Printed once by `node scripts/seed-oauth-client.js` (first deploy, see README).
# Compose rejects an empty value for every command, so keep `pending` until the real secret exists.
CONSOLE_OIDC_CLIENT_SECRET=pending
EMAIL_FROM=
EMAIL_SERVER_URL=
POKETO_SECRET_KEY=
POKETO_WEBHOOK_SECRET=
# Shared with the gateway admin settings; the web app calls the gateway with it
NEWAPI_BRIDGE_TOKEN=
# Optional: Telegram/Discord webhook for admin alerts
ALERT_WEBHOOK_URL=

# Cloudflare Tunnel token (Zero Trust dashboard > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# Image tag for web/worker/migrate. CI sets it to the commit SHA on deploy; default latest.
# WEB_TAG=latest
