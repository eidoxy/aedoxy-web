# Copy to .env.local and fill in. Never commit real values.
# Validated by src/env.ts. With ENV_STRICT=true every variable marked (later) is required.

NODE_ENV=development
ENV_STRICT=false

# Public
NEXT_PUBLIC_SITE_URL=https://aedoxy.com
NEWAPI_PUBLIC_URL=https://ai.aedoxy.com

# Database "aedoxy" (own DB user, TRD D8). Supabase/managed Postgres: use the pooler host. (later)
DATABASE_URL=

# Better Auth (later)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OIDC client for the New API console. scripts/seed-oauth-client.ts writes the secret to .env.local (later)
CONSOLE_OIDC_CLIENT_ID=aedoxy-console
CONSOLE_OIDC_CLIENT_SECRET=

# Transactional email over SMTP (nodemailer URL; URL-encode special characters in credentials).
# Mailtrap Sandbox: smtp://USER:PASS@sandbox.smtp.mailtrap.io:2525 (captures only, never delivers)
# Mailtrap Sending: smtp://api:TOKEN@live.smtp.mailtrap.io:587
EMAIL_FROM=Aedoxy <no-reply@aedoxy.com>
EMAIL_SERVER_URL=
# DEV/TEST ONLY: absolute file path; each email is appended as one JSON line. Forbidden when ENV_STRICT=true.
# EMAIL_DEV_OUTBOX=

# Poketo (later)
POKETO_SECRET_KEY=
POKETO_WEBHOOK_SECRET=

# New API bridge, reachable on the Docker network only (later)
NEWAPI_INTERNAL_URL=
NEWAPI_BRIDGE_TOKEN=

# Optional: Telegram/Discord webhook for admin alerts
ALERT_WEBHOOK_URL=
